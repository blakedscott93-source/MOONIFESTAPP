# Supabase Configuration
# Get these from https://app.supabase.com/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# RevenueCat Configuration (for subscriptions)
# Get these from https://app.revenuecat.com/projects/[project]/api_keys
# Use the "Public SDK Key" for each platform
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your-ios-sdk-key-here
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your-android-sdk-key-here
# Optional fallback if you want a single key name in code (not recommended if you ship both platforms)
EXPO_PUBLIC_REVENUECAT_API_KEY=your-sdk-key-here

# Stripe Configuration (for premium features)
# Get from https://dashboard.stripe.com/apikeys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# Sentry Configuration (optional - for error tracking)
# Get from https://sentry.io/settings/projects/
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
